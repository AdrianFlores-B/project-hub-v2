DATABASE_URL=postgresql+asyncpg://projecthub:projecthub@localhost:5432/projecthub
# must be at least 32 bytes for HS256
JWT_SECRET=dev-only-secret-change-me-in-prod-please
JWT_EXPIRES_MINUTES=60

# defaults point at localstack; unset S3_ENDPOINT_URL to use real AWS
S3_ENDPOINT_URL=http://localhost:4566
S3_BUCKET=projecthub-documents
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1

# shared secret between the size-calculator lambda and the API
INTERNAL_TOKEN=dev-internal-token
PROJECT_SIZE_LIMIT_BYTES=52428800

# share-by-email (defaults point at the mailpit container)
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM=noreply@projecthub.local
APP_BASE_URL=http://localhost:8000
SHARE_TOKEN_EXPIRES_HOURS=72
